APP_NAME=tutor
APP_DISPLAY_NAME=
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=90
MAX_QUERY_CHARS=4000
MAX_SPEECH_CHARS=2000
MAX_SCRIPT_LINES=50
MAX_STT_BYTES=8388608
MAX_BOARD_ELEMENTS_PER_SEGMENT=18

DEMO_SCRIPT="An MCB is a miniature circuit breaker.
It protects wiring from overload and short circuit.
When current is too high, it trips and cuts the power."

VITE_API_BASE_URL=http://127.0.0.1:8787

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=local
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=4096

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_REQUEST_TIMEOUT_SECONDS=45

TTS_PROVIDER=edge
TTS_FALLBACK_PROVIDER=browser
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%
TTS_SPEECH_RATE=1

STT_PROVIDER=groq
STT_FALLBACK_PROVIDER=browser
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

BOARD_TITLE_COLOR=#1e3a5f
BOARD_BOX_BG=#a5d8ff
BOARD_BOX_STROKE=#1971c2
BOARD_ACCENT=#d97757
BOARD_TEXT_COLOR=#212529
BOARD_SECOND_BG=#ffd8a8
BOARD_THIRD_BG=#b2f2bb

AVATAR_ENABLED=true
AVATAR_MODULE=simli
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_BASE_URL=https://api.simli.ai
SIMLI_MAX_SESSION_LENGTH=600
SIMLI_MAX_IDLE_TIME=180
